rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Board data is readable and writable by anyone signed in
    // through the app (anonymous auth). See SETUP-FIREBASE.md
    // for what this trade-off means and how to tighten it.
    match /boards/{boardId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Nothing else in the project is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
